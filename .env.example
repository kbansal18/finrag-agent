# Copy to `.env` and fill in. `.env` is git-ignored; this template is committed.

# https://console.groq.com/keys
GROQ_API_KEY=
# Optional: openai/gpt-oss-120b (default) or openai/gpt-oss-20b
# LLM_MODEL=openai/gpt-oss-120b

# SEC requires a descriptive User-Agent with a contact email on every request:
# https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT="Your Name your.email@example.com"
